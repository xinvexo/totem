# Totem runtime configuration
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=./totem.db

# Used only if the database has no administrator yet. Remove after first boot.
ADMIN_PASSWORD=change-me

# Generate with: openssl rand -hex 32
# Keep this value backed up separately from totem.db. It cannot be recovered.
MASTER_KEY=

# Set true when Totem is served through HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# Optional: info, totem=debug, etc.
RUST_LOG=info
